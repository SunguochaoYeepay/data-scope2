<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE configuration PUBLIC "-//mybatis.org//DTD Config 3.0//EN" "http://mybatis.org/dtd/mybatis-3-config.dtd">
<configuration>
    <settings>
        <!-- 使用驼峰命名转换 -->
        <setting name="mapUnderscoreToCamelCase" value="true"/>
        <!-- 开启二级缓存 -->
        <setting name="cacheEnabled" value="true"/>
        <!-- 开启延迟加载 -->
        <setting name="lazyLoadingEnabled" value="true"/>
        <!-- 设置日志实现 -->
        <setting name="logImpl" value="SLF4J"/>
    </settings>

    <typeHandlers>
        <!-- 枚举类型处理器 -->
        <typeHandler handler="com.datascope.infrastructure.mybatis.handler.EnumTypeHandler"
                    javaType="com.datascope.domain.query.enums.ColumnAlign"/>
        <typeHandler handler="com.datascope.infrastructure.mybatis.handler.EnumTypeHandler"
                    javaType="com.datascope.domain.query.enums.ColumnFixed"/>
        <typeHandler handler="com.datascope.infrastructure.mybatis.handler.EnumTypeHandler"
                    javaType="com.datascope.domain.query.enums.MaskType"/>
    </typeHandlers>
</configuration>